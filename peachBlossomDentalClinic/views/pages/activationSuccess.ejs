<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Activation Success</title>

  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="min-h-screen bg-gradient-to-br from-[#FF9C87] via-white to-[#66B3FF] flex items-center justify-center px-4">

  <!-- Card -->
  <div class="w-full max-w-md bg-white/80 backdrop-blur-xl border border-white/40 shadow-2xl rounded-3xl p-8 text-center">

    <!-- Success Icon -->
    <div class="flex justify-center mb-4">
      <div class="w-20 h-20 rounded-full bg-green-100 flex items-center justify-center shadow-inner">
        <svg class="w-10 h-10 text-green-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
        </svg>
      </div>
    </div>

    <!-- Heading -->
    <h2 class="text-3xl font-extrabold text-gray-800 mb-2">
      Account Activated
    </h2>

    <p class="text-gray-500 text-sm mb-6">
      Your account has been successfully verified and is ready to use.
    </p>

    <!-- Success Box -->
    <div class="bg-green-50 border border-green-200 text-green-700 text-sm px-4 py-3 rounded-xl mb-6">
       You can now securely log in to your Peach Blossom dashboard.
    </div>

        <!-- Buttons -->
        <div class="flex gap-3">

        <!-- Login Button -->
        <a href="/patient/signIn"
            class="flex-1 bg-[#FF9C87] hover:bg-[#e68274] text-white font-semibold py-3 rounded-xl shadow-md transition duration-200 text-center">
            Login
        </a>

        <!-- Home Button -->
        <a href="/"
            class="flex-1 bg-blue-200 border border-blue-200 text-gray-700 hover:bg-blue-400 font-semibold py-3 rounded-xl transition duration-200 text-center">
            Home
        </a>

        </div>

  </div>

</body>
</html>