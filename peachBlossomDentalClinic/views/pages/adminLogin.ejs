<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Admin Login</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="min-h-screen bg-gradient-to-br from-[#FFDED5] via-white to-[#66B3FF] flex items-center justify-center">
    
    <div class="bg-white/90 rounded-3xl shadow-2xl p-12 w-full max-w-md">
        <!-- Header -->
        <h2 class="text-4xl font-bold text-center text-sky-700 mb-8">Admin Login</h2>
        
        <!-- Form -->
        <form action="/admin/login" method="post" class="space-y-6" autocomplete="new-email">
            <div>
                <label class="block text-gray-700 font-medium mb-2">Email</label>
                <input 
                    type="email" 
                    name="email" 
                    autocomplete="off"
                    placeholder="Enter an Email"
                    required 
                    class="w-full px-4 py-3 rounded-xl border border-sky-300 focus:outline-none focus:ring-2 focus:ring-sky-400 focus:border-transparent transition"
                >
            </div>

            <div>
                <label class="block text-gray-700 font-medium mb-2">Password</label>
                <input 
                    type="password" 
                    name="password" 
                    autocomplete="new-password"
                    placeholder="Enter Password"
                    required 
                    class="w-full px-4 py-3 rounded-xl border border-sky-300 focus:outline-none focus:ring-2 focus:ring-sky-400 focus:border-transparent transition"
                >
            </div>

            <div class="text-center">
             <button type="submit"
              class="w-40 items-center bg-gradient-to-r from-[#FF9C87] to-[#66B3FF] hover:from-[#FF7A5F] hover:to-[#3399FF] text-white font-bold py-3 rounded-lg shadow-lg transition-all duration-300">
              Login
             </button>
            </div>
        </form>
        

        <p class="text-center text-gray-600 mt-6">
            Back to <a href="/" class="text-sky-700 font-semibold hover:underline">Home</a>
        </p>
    </div>

    <!-- Show Credentials Box-->
<div class="absolute top-10 right-10">

  <!-- Toggle Button -->
  <button id="showCreds"
    class="px-5 py-2 rounded-xl font-semibold text-white
           bg-gradient-to-r from-[#FF9C87] to-[#66B3FF]
           hover:from-[#FF7A5F] hover:to-[#3399FF]
           shadow-lg transition duration-300">
    Show Credentials
  </button>

  <!-- Credential Box -->
  <div id="credBox"
    class="mt-4 w-72 hidden rounded-2xl overflow-hidden shadow-2xl
           backdrop-blur-lg bg-white/80 border border-sky-200">

    <!-- Header -->
    <div class="bg-gradient-to-r from-[#FF9C87] to-[#66B3FF] p-3">
      <h3 class="text-white font-bold text-center">
        Admin Credentials
      </h3>
    </div>

    <!-- Content -->
    <div class="p-4 text-gray-700 space-y-2">
      <p>
        <span class="font-semibold">Email:</span>
        <span class="font-mono">admin@gmail.com</span>
      </p>
      <p>
        <span class="font-semibold">Password:</span>
        <span class="font-mono">123456</span>
      </p>
    </div>
  </div>
</div>

<script>
    const showBtn = document.getElementById('showCreds')
    const boxCred = document.getElementById('credBox')

    showBtn.addEventListener('click',()=>{
        boxCred.classList.toggle('hidden')
    })
</script>
</body>
</html>
