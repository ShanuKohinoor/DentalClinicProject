                <% } %>

                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <div id="noResults" class="hidden text-center text-slate-500 py-8 font-semibold text-base">
        No results found
      </div>
    </div>

    <!-- no results for mobile cards -->
    <div id="noResultsCards" class="hidden text-center text-slate-500 py-8 font-semibold text-base">
      No results found
    </div>

  </main>

  <!-- SEARCH SCRIPT -->
  <script>
    const searchInput = document.getElementById('searchInput');
    const tableRows = document.querySelectorAll('.appointment-row');
    const cards = document.querySelectorAll('.appointment-card');
    const noResults = document.getElementById('noResults');
    const noResultsCards = document.getElementById('noResultsCards');

    searchInput.addEventListener('input', function () {
      const filter = this.value.toLowerCase();
      let visibleDesktop = 0;
      let visibleCards = 0;

      // Desktop rows
      tableRows.forEach(row => {
        const cells = row.querySelectorAll('td');
        const patient = cells[2]?.textContent.toLowerCase() || '';
        const doctor = cells[4]?.textContent.toLowerCase() || '';
        const match = patient.includes(filter) || doctor.includes(filter);

        row.style.display = match ? '' : 'none';
        if (match) visibleDesktop++;
      });

      // Mobile / tablet cards
      cards.forEach(card => {
        const text = card.textContent.toLowerCase();
        const match = text.includes(filter);

        card.style.display = match ? '' : 'none';
        if (match) visibleCards++;
      });

      // desktop no results
      if (tableRows.length > 0) {
        if (visibleDesktop === 0) {
          noResults.classList.remove('hidden');
        } else {
          noResults.classList.add('hidden');
        }
      }

      // card no results
      if (cards.length > 0) {
        if (visibleCards === 0) {
          noResultsCards.classList.remove('hidden');
        } else {
          noResultsCards.classList.add('hidden');
        }
      }
    });
  </script>

  <!-- CONFIRMATION MODAL -->
  <div id="confirmModal"
      class="hidden fixed inset-0 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center z-50 px-4">
    <div class="bg-white w-full max-w-md rounded-3xl shadow-2xl border border-[#FBD2C9]/60 overflow-hidden">
      
      <!-- top -->
      <div class="px-6 py-5 bg-gradient-to-r from-[#FFF0EC] to-[#FFE5DF] border-b border-[#FBD2C9]/60">
        <h2 id="modalTitle" class="text-xl sm:text-2xl font-bold text-slate-800">
          Confirm Action
        </h2>
      </div>

      <!-- body -->
      <div class="px-6 py-5">
        <p id="modalMessage" class="text-sm sm:text-base text-slate-600 leading-7">
          Are you sure?
        </p>

        <div class="flex flex-col sm:flex-row justify-end gap-3 mt-6">
          <button
            type="button"
            onclick="closeModal()"
            class="w-full sm:w-auto px-5 py-3 bg-slate-200 hover:bg-slate-300 text-slate-700 rounded-xl font-semibold transition">
            Cancel
          </button>

          <button
            type="button"
            id="confirmBtn"
            class="w-full sm:w-auto px-5 py-3 text-white bg-red-600 hover:bg-red-700 rounded-xl font-semibold transition">
            Confirm
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- MODAL SCRIPT -->
  <script>
    let activeForm = null;

    function openModal(form, type) {
      activeForm = form;

      const modal = document.getElementById('confirmModal');
      const title = document.getElementById('modalTitle');
      const message = document.getElementById('modalMessage');
      const confirmBtn = document.getElementById('confirmBtn');

      if (type === 'confirm') {
        title.textContent = 'Confirm Appointment';
        message.textContent = 'Are you sure you want to CONFIRM this appointment?';
        confirmBtn.textContent = 'Yes, Confirm';
        confirmBtn.className =
          'w-full sm:w-auto px-5 py-3 text-white bg-green-600 hover:bg-green-700 rounded-xl font-semibold transition';
      }

      if (type === 'cancel') {
        title.textContent = 'Cancel Appointment';
        message.textContent = 'Are you sure you want to CANCEL this appointment?';
        confirmBtn.textContent = 'Yes, Cancel';
        confirmBtn.className =
          'w-full sm:w-auto px-5 py-3 text-white bg-orange-600 hover:bg-orange-700 rounded-xl font-semibold transition';
      }

      if (type === 'complete') {
        title.textContent = 'Complete Appointment';
        message.textContent = 'Are you sure you want to mark this appointment as COMPLETED?';
        confirmBtn.textContent = 'Complete';
        confirmBtn.className =
          'w-full sm:w-auto px-5 py-3 text-white bg-green-600 hover:bg-green-700 rounded-xl font-semibold transition';
      }

      if (type === 'delete') {
        title.textContent = 'Delete Appointment';
        message.textContent = 'Are you sure you want to DELETE this appointment? This action cannot be undone.';
        confirmBtn.textContent = 'Delete';
        confirmBtn.className =
          'w-full sm:w-auto px-5 py-3 text-white bg-red-600 hover:bg-red-700 rounded-xl font-semibold transition';
      }

      modal.classList.remove('hidden');
    }

    function closeModal() {
      document.getElementById('confirmModal').classList.add('hidden');
      activeForm = null;
    }

    document.getElementById('confirmBtn').addEventListener('click', function () {
      if (activeForm) {
        activeForm.submit();
      }
    });
  </script>

</body>
</html>