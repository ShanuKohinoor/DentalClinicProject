<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title><%= title %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Tailwind -->
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

  <style>
    .custom-scrollbar::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: transparent;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: rgba(255, 122, 99, 0.25);
      border-radius: 9999px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
      background: rgba(255, 122, 99, 0.45);
    }
  </style>
</head>

<body class="min-h-screen bg-[#FCF8F7] font-sans text-slate-700">

<div class="max-w-[1600px] mx-auto px-4 sm:px-5 lg:px-6 py-6 sm:py-8">
    <!-- TOP HEADER SECTION -->
    <section class="mb-8">
      
      <!-- Back + Title + Add Button -->
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-6">
        
        <!-- Back -->
        <a href="/admin/home"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-white border border-[#FBD2C9] text-slate-600 font-semibold text-sm shadow-sm hover:bg-[#FFF7F5] hover:text-[#FF7A63] transition w-fit">
          <i class="fa-solid fa-arrow-left text-xs"></i>
          Back to Dashboard
        </a>
              <!--  Title -->
      <div class="mb-6">
        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-800 tracking-tight">
          Patient Appointments
        </h1>

      </div>
        <!-- Add Appointment -->
        <a href="/admin/addAppointment"
          class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-[#FF7A63] text-white font-semibold text-sm shadow-md hover:bg-[#E96A55] transition w-full sm:w-auto">
          <i class="fa-solid fa-plus"></i>
          Add New Appointment
        </a>
      </div>

      <!-- Search + Total Count -->
<div class="flex justify-end items-center gap-3">

  <!-- Search -->
  <div class="relative">

<input
  type="text"
  id="searchInput"
  placeholder="Search"
  class="
  peer
  w-28
  focus:w-72
  transition-all
  duration-300
  ease-in-out
  rounded-xl
  border
  border-[#FBD2C9]
  bg-[#FFF8F6]
  pl-11
  pr-4
  py-3
  text-sm
  font-medium
  text-slate-700
  placeholder:text-slate-400
  focus:placeholder:text-slate-400
  focus:outline-none
  focus:ring-2
  focus:ring-[#FF7A63]
  focus:border-[#FF7A63]
  "
/>

<i class="
fa-solid fa-magnifying-glass
absolute
left-4
top-1/2
-translate-y-1/2
text-[#FF7A63]
pointer-events-none
"></i>

  </div>


  <!-- Total Appointment Card -->
  <div class="bg-gradient-to-r from-[#FFF0EC] to-[#FFE5DF] border border-[#FBD2C9] rounded-2xl shadow-sm px-5 py-4 flex items-center gap-4 min-w-[220px]">

    <div class="w-12 h-12 rounded-xl bg-white text-[#FF7A63] flex items-center justify-center shadow-sm">
      <i class="fa-solid fa-calendar-check text-lg"></i>
    </div>

    <div>
      <p class="text-xs uppercase tracking-wider font-bold text-slate-500">
        Total Appointments
      </p>

      <h3 class="text-2xl font-extrabold text-slate-800 mt-1">
        <%= appointment.length %>
      </h3>
    </div>

  </div>

</div>

</section>

    
    <!-- MOBILE + TABLET CARD VIEW -->
    <div id="appointmentCards" class="xl:hidden grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
      <% appointment.forEach((app, index) => { %>
        <div class="appointment-card bg-white border border-[#FBD2C9]/50 rounded-3xl shadow-sm overflow-hidden">
          
          <!-- card top -->
          <div class="px-4 py-4 bg-gradient-to-r from-[#FFF8F6] to-white border-b border-[#FBD2C9]/40">
            <div class="flex items-start justify-between gap-3">
              <div>
                <p class="text-xs font-bold uppercase tracking-wider text-slate-400">Appointment #<%= index + 1 %></p>
                <h2 class="text-lg sm:text-xl font-bold text-slate-800 mt-1"><%= app.name %></h2>
                <p class="text-sm text-slate-500 mt-1">
                  Dr. <%= app.doctor?.name || '—' %>
                </p>
              </div>

              <!-- Status -->
              <div>
                <% if(app.status === 'Scheduled') { %>
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold text-amber-700 bg-amber-50 border border-amber-200">Pending</span>
                <% } else if(app.status === 'Confirmed') { %>
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold text-emerald-700 bg-emerald-50 border border-emerald-200">Confirmed</span>
                <% } else if(app.status === 'Completed') { %>
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold text-green-700 bg-green-50 border border-green-200">Completed</span>
                <% } else if(app.status === 'Cancelled') { %>
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold text-rose-700 bg-rose-50 border border-rose-200">Cancelled</span>
                <% } %>
              </div>
            </div>
          </div>

          <!-- card body -->
          <div class="p-4 space-y-4">
            <div class="grid grid-cols-2 gap-3 text-sm">
              <div class="bg-slate-50 rounded-2xl p-3 border border-slate-100">
                <p class="text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-1">Reg No</p>
                <p class="font-semibold text-slate-800"><%= app.patient?.registrationNumber || '—' %></p>
              </div>

              <div class="bg-slate-50 rounded-2xl p-3 border border-slate-100">
                <p class="text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-1">Patient Type</p>
                <% if(app.patientType === 'new'){ %>
                  <span class="inline-flex px-3 py-1 rounded-full text-xs font-bold text-white bg-[#FF7A63]">New</span>
                <% } else { %>
                  <span class="inline-flex px-3 py-1 rounded-full text-xs font-bold text-white bg-sky-500">Existing</span>
                <% } %>
              </div>

              <div class="bg-slate-50 rounded-2xl p-3 border border-slate-100">
                <p class="text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-1">Date</p>
                <p class="font-semibold text-slate-800">
                  <%= app.appointmentDate.toLocaleDateString('en-GB', {
                    day: '2-digit', month: '2-digit', year: 'numeric'
                  }) %>
                </p>
              </div>

              <div class="bg-slate-50 rounded-2xl p-3 border border-slate-100">
                <p class="text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-1">Time</p>
                <p class="font-semibold text-slate-800"><%= app.appointmentTime %></p>
              </div>
            </div>

            <!-- Actions -->
            <div class="pt-1">
              <p class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3">Actions</p>

              <div class="grid grid-cols-3 sm:grid-cols-4 gap-2">

                <!-- Edit -->
                <a href="/admin/editAppointment/<%= app._id %>"
                  title="Edit Appointment"
                  class="h-11 rounded-xl flex items-center justify-center text-sm shadow-sm border font-semibold
                  <%= app.status === 'Completed'
                    ? 'bg-slate-100 text-slate-400 border-slate-200 pointer-events-none opacity-60'
                    : 'bg-sky-50 text-sky-700 border-sky-200 hover:bg-sky-100' %>">
                  <i class="fa-solid fa-pen-to-square"></i>
                </a>

                <!-- Confirm -->
                <form action="/admin/confirmAppointment/<%= app._id %>" method="POST" title="Confirm Appointment">
                  <button
                    type="button"
                    onclick="openModal(this.form,'confirm')"
                    class="w-full h-11 rounded-xl text-sm shadow-sm border font-semibold
                    <%= app.status === 'Confirmed' || app.status === 'Completed'
                      ? 'bg-slate-100 text-slate-400 border-slate-200 cursor-not-allowed'
                      : 'bg-emerald-50 text-emerald-700 border-emerald-200 hover:bg-emerald-100' %>"
                    <%= app.status === 'Confirmed' || app.status === 'Completed' ? 'disabled' : '' %>>
                    <i class="fa-solid fa-check"></i>
                  </button>
                </form>

                <!-- Cancel -->
                <form action="/admin/cancelAppointment/<%= app._id %>" method="POST" title="Cancel Appointment">
                  <button
                    type="button"
                    onclick="openModal(this.form,'cancel')"
                    class="w-full h-11 rounded-xl text-sm shadow-sm border font-semibold
                    <%= app.status === 'Completed'
                      ? 'bg-slate-100 text-slate-400 border-slate-200 cursor-not-allowed'
                      : 'bg-orange-50 text-orange-700 border-orange-200 hover:bg-orange-100' %>"
                    <%= app.status === 'Completed' ? 'disabled' : '' %>>
                    <i class="fa-solid fa-xmark"></i>
                  </button>
                </form>

                <!-- Complete -->
                <form action="/admin/completeAppointment/<%= app._id %>" method="POST" title="Completed">
                  <% const isCompletedMobile = app.status === 'Completed'; %>
                  <button
                    type="button"
                    onclick="openModal(this.form,'complete')"
                    class="w-full h-11 rounded-xl text-sm shadow-sm border font-semibold
                    <%= isCompletedMobile
                      ? 'bg-slate-100 text-slate-400 border-slate-200 cursor-not-allowed'
                      : 'bg-green-50 text-green-700 border-green-200 hover:bg-green-100' %>"
                    <%= isCompletedMobile ? 'disabled' : '' %>>
                    <i class="fa-solid fa-circle-check"></i>
                  </button>
                </form>

                <!-- Delete -->
                <form action="/admin/deleteAppointment/<%= app._id %>" method="POST" title="Delete">
                  <button
                    type="button"
                    onclick="openModal(this.form,'delete')"
                    class="w-full h-11 rounded-xl text-sm shadow-sm border font-semibold bg-rose-50 text-rose-700 border-rose-200 hover:bg-rose-100">
                    <i class="fa-solid fa-trash"></i>
                  </button>
                </form>

                <!-- Invoice -->
                <% if (app.status === 'Completed') { %>
                  <a href="/admin/appointment/<%= app._id %>/invoice"
                    title="View Invoice"
                    class="h-11 rounded-xl flex items-center justify-center text-sm shadow-sm border font-semibold bg-violet-50 text-violet-700 border-violet-200 hover:bg-violet-100">
                    <i class="fa-solid fa-file-invoice"></i>
                  </a>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>

    <!-- DESKTOP TABLE VIEW -->
    <div class="hidden xl:block bg-white border border-[#FBD2C9]/60 rounded-3xl shadow-sm overflow-hidden">
      <div class="overflow-x-auto custom-scrollbar">
        <table class="w-full table-fixed text-left">
            <thead class="bg-[#FFF3EF] border-b border-[#FBD2C9]/60">
            <tr class="text-slate-600 uppercase tracking-wider text-sm">

              <th class="px-5 py-4 font-bold text-center w-[60px]">
                S.No
              </th>

              <th class="px-5 py-4 font-bold w-[120px]">
                Reg No
              </th>

              <th class="px-5 py-4 font-bold w-[170px]">
                Patient
              </th>

              <th class="px-5 py-4 font-bold w-[120px]">
                Type
              </th>

              <th class="px-5 py-4 font-bold w-[150px]">
                Doctor
              </th>

              <th class="px-5 py-4 font-bold w-[120px]">
                Date
              </th>

              <th class="px-5 py-4 font-bold w-[100px]">
                Time
              </th>

              <th class="px-5 py-4 font-bold w-[120px]">
                Status
              </th>

              <th class="px-5 py-4 font-bold text-center w-[250px]">
                Actions
              </th>

              <th class="px-5 py-4 font-bold text-center w-[90px]">
                Invoice
              </th>

            </tr>
          </thead>

          <tbody id="appointmentTable" class="divide-y divide-slate-100">
            <% appointment.forEach((app, index) => { %>
              <tr class="appointment-row hover:bg-[#FFF8F6] transition">
                <td class="px-5 py-4 text-center text-sm font-semibold text-slate-500"><%= index + 1 %></td>

                <td class="px-5 py-4 text-sm font-bold text-[#FF7A63]">
                  <%= app.patient?.registrationNumber || '—' %>
                </td>

                <td class="px-5 py-4">
                  <div class="font-bold text-slate-800 text-base"><%= app.name %></div>
                </td>

                <td class="px-5 py-4">
                  <% if(app.patientType === 'new'){ %>
                    <span class="inline-flex px-3 py-1 rounded-full text-xs font-bold text-white bg-[#FF7A63]">New</span>
                  <% } else { %>
                    <span class="inline-flex px-3 py-1 rounded-full text-xs font-bold text-white bg-sky-500">Existing</span>
                  <% } %>
                </td>

                <td class="px-5 py-4 text-sm font-semibold text-slate-700">
                  Dr. <%= app.doctor?.name || '—' %>
                </td>

                <td class="px-5 py-4 text-sm font-medium text-slate-600">
                  <%= app.appointmentDate.toLocaleDateString('en-GB', {
                    day: '2-digit', month: '2-digit', year: 'numeric'
                  }) %>
                </td>

                <td class="px-5 py-4 text-sm font-semibold text-slate-700">
                  <%= app.appointmentTime %>
                </td>

                <!-- Status -->
                <td class="px-5 py-4">
                  <% if(app.status === 'Scheduled') { %>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold text-amber-700 bg-amber-50 border border-amber-200">Pending</span>
                  <% } else if(app.status === 'Confirmed') { %>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold text-emerald-700 bg-emerald-50 border border-emerald-200">Confirmed</span>
                  <% } else if(app.status === 'Completed') { %>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold text-green-700 bg-green-50 border border-green-200">Completed</span>
                  <% } else if(app.status === 'Cancelled') { %>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold text-rose-700 bg-rose-50 border border-rose-200">Cancelled</span>
                  <% } %>
                </td>

                <!-- Actions -->
        <td class="px-5 py-4 w-[300px]">
          
          <div class="bg-[#FFF8F6] border border-[#FBD2C9] rounded-2xl p-3">


            <div class="flex items-center justify-center gap-2 flex-wrap">
                              <!-- Edit -->
                    <a href="/admin/editAppointment/<%= app._id %>"
                      title="Edit Appointment"
                      class="h-8 w-8 px-1 rounded-xl flex items-center justify-center shadow-sm border font-semibold
                      <%= app.status === 'Completed'
                        ? 'bg-slate-100 text-slate-400 border-slate-200 pointer-events-none opacity-60'
                        : 'bg-sky-50 text-sky-700 border-sky-200 hover:bg-sky-100' %>">
                      <i class="fa-solid fa-pen-to-square"></i>
                    </a>

                    <!-- Confirm -->
                    <form action="/admin/confirmAppointment/<%= app._id %>" method="POST" title="Confirm Appointment">
                      <button
                        type="button"
                        onclick="openModal(this.form,'confirm')"
                        class="h-8 w-8 rounded-xl shadow-sm border font-semibold
                        <%= app.status === 'Confirmed' || app.status === 'Completed'
                          ? 'bg-slate-100 text-slate-400 border-slate-200 cursor-not-allowed'
                          : 'bg-emerald-50 text-emerald-700 border-emerald-200 hover:bg-emerald-100' %>"
                        <%= app.status === 'Confirmed' || app.status === 'Completed' ? 'disabled' : '' %>>
                        <i class="fa-solid fa-check"></i>
                      </button>
                    </form>

                    <!-- Cancel -->
                    <form action="/admin/cancelAppointment/<%= app._id %>" method="POST" title="Cancel Appointment">
                      <button
                        type="button"
                        onclick="openModal(this.form,'cancel')"
                        class="h-8 w-8 rounded-xl shadow-sm border font-semibold
                        <%= app.status === 'Completed'
                          ? 'bg-slate-100 text-slate-400 border-slate-200 cursor-not-allowed'
                          : 'bg-orange-50 text-orange-700 border-orange-200 hover:bg-orange-100' %>"
                        <%= app.status === 'Completed' ? 'disabled' : '' %>>
                        <i class="fa-solid fa-xmark"></i>
                      </button>
                    </form>

                    <!-- Complete -->
                    <form action="/admin/completeAppointment/<%= app._id %>" method="POST" title="Completed">
                      <% const isCompleted = app.status === 'Completed'; %>
                      <button
                        type="button"
                        onclick="openModal(this.form,'complete')"
                        class="h-8 w-8 rounded-xl shadow-sm border font-semibold
                        <%= isCompleted
                          ? 'bg-slate-100 text-slate-400 border-slate-200 cursor-not-allowed'
                          : 'bg-green-50 text-green-700 border-green-200 hover:bg-green-100' %>"
                        <%= isCompleted ? 'disabled' : '' %>>
                        <i class="fa-solid fa-circle-check"></i>
                      </button>
                    </form>

                    <!-- Delete -->
                    <form action="/admin/deleteAppointment/<%= app._id %>" method="POST" title="Delete">
                      <button
                        type="button"
                        onclick="openModal(this.form,'delete')"
                        class="h-8 w-8 rounded-xl shadow-sm border font-semibold bg-rose-50 text-rose-700 border-rose-200 hover:bg-rose-100">
                        <i class="fa-solid fa-trash"></i>
                      </button>
                    </form>
            </div>

                  </div>
                </td>
                <!-- Invoice -->
                <td class="px-5 py-4 text-center">

                <% if (app.status === 'Completed') { %>

                <a href="/admin/appointment/<%= app._id %>/invoice"
                  title="View Invoice"
                  class="inline-flex h-10 w-10 items-center justify-center rounded-xl 
                  shadow-sm border font-semibold
                  bg-violet-50 text-violet-700 border-violet-200 
