<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="min-h-screen bg-gradient-to-br from-[#FF9C87] via-white to-[#66B3FF] py-10">

<div class="relative max-w-5xl mx-auto bg-white/70 backdrop-blur-xl border border-white/40 rounded-3xl shadow-2xl overflow-hidden">

  <!-- HEADER -->
  <div class="flex justify-between items-center bg-gradient-to-r from-[#FF9C87] via-white to-[#66B3FF] px-8 py-6">
    <h1 class="text-3xl font-extrabold text-gray-800">
      <i class="fa-solid fa-user text-sky-600 mr-2"></i> Patient Profile
    </h1>

    <a href="/admin/patient/<%= patient._id %>/edit"
       class="flex items-center gap-2 px-4 py-2 bg-[#FF9C87] text-white font-semibold rounded-lg shadow-lg hover:bg-[#E68C7A] transition">
      <i class="fa-solid fa-pen"></i> Edit Patient
    </a>
  </div>

  <!-- PATIENT INFO -->
  <div class="px-8 py-6 grid grid-cols-1 md:grid-cols-2 gap-y-4 gap-x-8 text-gray-700">

    <div class="p-4 bg-blue-100 rounded-xl shadow">
      <b>Name:</b> <%= patient.name %>
    </div>

    <div class="p-4 bg-blue-100 rounded-xl shadow">
      <b>Age:</b> <%= patient.age || '-' %>
    </div>

    <div class="p-4 bg-blue-100 rounded-xl shadow">
      <b>Gender:</b> <%= patient.gender || '-' %>
    </div>

    <div class="p-4 bg-blue-100 rounded-xl shadow">
      <b>Phone:</b> <%= patient.phone %>
    </div>

    <div class="p-4 bg-blue-100 rounded-xl shadow">
      <b>Email:</b> <%= patient.email || '-' %>
    </div>

    <div class="p-4 bg-blue-100 rounded-xl shadow">
      <b>Registration:</b> <%= patient.registrationNumber || '-' %>
    </div>

    <div class="p-4 bg-blue-100 rounded-xl shadow">
      <b>Registered On:</b>
      <%= patient.createdAt.toLocaleDateString('en-GB') %>
    </div>

  </div>

  <!-- APPOINTMENTS SECTION -->
  <div class="px-8 py-6">

    <h2 class="text-xl font-bold mb-4 text-gray-800">
      Appointments
    </h2>

    <% if (!appointments || appointments.length === 0) { %>
      <p class="text-gray-500">No appointments found.</p>
    <% } else { %>

      <div class="space-y-3">

        <% appointments.forEach(app => { %>

          <div class="p-4 bg-white rounded-lg shadow flex justify-between items-center">

            <div>
              <p><b>Date:</b> <%= new Date(app.appointmentDate).toDateString() %></p>
              <p><b>Time:</b> <%= app.appointmentTime %></p>
              <p><b>Doctor:</b> <%= app.doctor?.name || 'Not Assigned' %></p>
              <p><b>Status:</b> <%= app.status %></p>
            </div>
            

            <a href="/admin/appointment/<%= app._id %>/view"
               class="px-3 py-1 bg-blue-500 text-white rounded hover:bg-blue-600">
              View
            </a>

          </div>

        <% }) %>

      </div>

    <% } %>

  </div>

  <!-- BACK BUTTON -->
  <div class="px-8 py-6 flex justify-end">
    <a href="/admin/patientDetails"
       class="px-4 py-2 bg-[#FF9C87] text-white rounded-lg">
      <i class="fa-solid fa-arrow-left"></i> Back
    </a>
  </div>

</div>

</body>
</html>