<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="min-h-screen bg-gradient-to-br from-[#FF9C87] via-white to-[#66B3FF] py-10">

<div class="relative max-w-5xl mx-auto bg-white/70 backdrop-blur-xl border border-white/40 rounded-3xl shadow-2xl overflow-hidden">
    <!-- Header -->
    <div class="flex justify-between items-center bg-gradient-to-r from-[#FF9C87] via-white to-[#66B3FF] px-8 py-6">
      <h1 class="text-3xl font-extrabold text-gray-800">Doctor Profile</h1>
      <div class="flex items-center gap-3">
        <button onclick="openPaymentModal('<%= dentist._id %>', '<%= dentist.name %>')"
                class="flex items-center gap-2 px-4 py-2 bg-[#66B3FF] text-white font-semibold rounded-lg shadow-lg hover:bg-[#4FA0E0] transition">
          <i class="fa-solid fa-wallet"></i> Update Payment
        </button>
        <a href="/admin/doctor/<%= dentist._id %>/edit" 
           class="flex items-center gap-2 px-4 py-2 bg-[#FF9C87] text-white font-semibold rounded-lg shadow-lg hover:bg-[#E68C7A] transition">
          <i class="fa-solid fa-pen"></i> Edit Doctor 
        </a>
      </div>
    </div>

    <!-- Doctor Info -->
<div class="px-8 py-6 grid grid-cols-1 md:grid-cols-2 gap-y-4 gap-x-8  text-gray-700">

  <!-- Name -->
  <div class=" p-4 bg-blue-100 rounded-xl shadow hover:shadow-xl transition">
    <span class="font-semibold text-2xl text-gray-800">Name:</span>
    <span class="text-gray-900 text-lG">Dr. <%= dentist.name %></span>
  </div>

  <!-- Email -->
  <div class=" p-4 bg-blue-100 rounded-xl shadow hover:shadow-xl transition">
    <span class="font-semibold text-2xl text-gray-800">Email:</span>
    <span class="text-gray-900 text-lg"><%= dentist.email || 'N/A' %></span>
  </div>

  <!-- Phone -->
  <div class=" p-4 bg-blue-100 rounded-xl shadow hover:shadow-xl transition">
    <span class="font-semibold text-2xl text-gray-800">Phone:</span>
    <span class="text-gray-900 text-lg"><%= dentist.phoneNumber %></span>
  </div>

  <!-- Specialization -->
  <div class=" p-4 bg-blue-100 rounded-xl shadow hover:shadow-xl transition">
    <span class="font-semibold text-2xl text-gray-800">Specialization:</span>
    <span class="text-gray-900 text-lg"><%= dentist.specialization %></span>
  </div>

  <!-- Experience -->
  <div class=" p-4 bg-blue-100 rounded-xl shadow hover:shadow-xl transition">
    <span class="font-semibold text-2xl text-gray-800">Experience:</span>
    <span class="text-gray-900 text-lg"><%= dentist.experience || 'N/A' %> years</span>
  </div>

  <!-- Salary -->
  <div class=" p-4 bg-blue-100 rounded-xl shadow hover:shadow-xl transition">
    <span class="font-semibold text-2xl text-gray-800">Salary:</span>
    <span class="text-gray-900 text-lg">£<%= dentist.salary %></span>
  </div>

  <!-- Joined Date -->
  <div class=" p-4 bg-blue-100 rounded-xl shadow hover:shadow-xl transition">
    <span class="font-semibold text-2xl text-gray-800">Joined Date:</span>
    <span class="text-gray-900 text-lg"><%= dentist.createdAt.toLocaleDateString('en-GB', { day: '2-digit', month: '2-digit', year: 'numeric' }) %></span>
  </div>

  <!-- Available Days -->
  <div class=" p-4 bg-blue-100 rounded-xl shadow hover:shadow-xl transition">
    <span class="font-semibold text-2xl text-gray-800">Available Days:</span>
    <span class="text-gray-900 text-lg"><%= dentist.availableDays.join(', ') || 'N/A' %></span>
  </div>

</div>
    <!-- Actions -->
    <div class="px-8 py-6 flex flex-wrap gap-4">
      <a href="/admin/doctor/<%= dentist._id %>/paymentsHistory"
         class="px-4 py-2 bg-[#66B3FF] text-white font-semibold rounded-lg shadow-lg hover:bg-[#4FA0E0] transition">
        View Payment History
      </a>

      <a href="/admin/doctorDetails" 
         class="px-4 py-2 bg-[#FF9C87] text-white font-semibold rounded-lg shadow-lg hover:bg-[#E68C7A] transition">
        <i class="fa-solid fa-arrow-left"></i> Back to List
      </a>
    </div>

  </div>

<!-- Payment Modal -->
<div id="paymentModal" 
     class="fixed inset-0 bg-gradient-to-br from-[#FF9C87]/100 via-white/100 to-[#66B3FF]/100 backdrop-blur-sm hidden flex items-center justify-center z-50 p-4">
<div class="relative w-full max-w-3xl mx-auto bg-white/70 backdrop-blur-xl border border-white/40 rounded-3xl shadow-2xl overflow-hidden">
    <!-- Header -->
    <div class="bg-gradient-to-r from-[#FF9C87] via-white to-[#66B3FF] px-6 py-4">
      <h2 class="text-2xl font-bold text-gray-800 text-center">Update Payment</h2>
    </div>

    <!-- Form -->
    <form action="/admin/doctor/<%= dentist._id %>/manage" method="POST" class="px-6 py-6 space-y-4">

      <input type="hidden" name="doctorId" id="doctorId">

      <!-- Dentist Name -->
      <div>
        <label class="block font-medium text-gray-700 mb-1">Dentist Name</label>
        <input type="text" id="doctorName" disabled
               class="w-full border border-gray-300 rounded-lg px-3 py-2 bg-gray-100 text-gray-900 font-semibold" >
      </div>

      <!-- Month Selection -->
      <div>
        <label class="block font-medium text-gray-700 mb-1">Select Month</label>
        <select name="month" class="w-full border border-gray-300 rounded-lg px-3 py-2 hover:border-[#66B3FF]" required>
          <option value="">Select Month</option>
          <option>January</option>
          <option>February</option>
          <option>March</option>
          <option>April</option>
          <option>May</option>
          <option>June</option>
          <option>July</option>
          <option>August</option>
          <option>September</option>
          <option>October</option>
          <option>November</option>
          <option>December</option>
        </select>
      </div>

      <!-- Total Salary -->
      <div class="p-4 bg-gradient-to-r from-[#FF9C87] via-white to-[#66B3FF] rounded-xl shadow-md text-gray-900 font-semibold flex justify-between items-center">
        <span>Total Salary:</span>
        <span class="font-bold text-3xl">£<%= dentist.salary %></span>
      </div>

      <!-- Paid Amount -->
      <div>
        <label class="block font-medium text-gray-700 mb-1">Paid Amount</label>
        <input type="number" name="paidAmount" required class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:border-[#66B3FF] focus:ring-1 focus:ring-[#66B3FF]">
      </div>

      <!-- Payment Status -->
      <div>
        <label class="block font-medium text-gray-700 mb-1">Payment Status</label>
        <select name="status" class="w-full border border-gray-300 rounded-lg px-3 py-2 hover:border-[#66B3FF]">
          <option value="Paid">Paid</option>
          <option value="Pending">Pending</option>
        </select>
      </div>

      <!-- Transaction ID -->
      <div>
        <label class="block font-medium text-gray-700 mb-1">Transaction ID</label>
        <input type="text" name="transactionId" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:border-[#66B3FF] focus:ring-1 focus:ring-[#66B3FF]">
      </div>

      <!-- Actions -->
      <div class="flex justify-end gap-3 mt-4">
        <button type="button" onclick="closePaymentModal()"
                class="px-4 py-2 bg-gray-400 text-white rounded-lg hover:bg-gray-500 transition">
          Cancel
        </button>
        <button type="submit"
                class="px-4 py-2 bg-[#66B3FF] text-white rounded-lg hover:bg-[#4FA0E0] transition">
          Confirm Update
        </button>
      </div>

    </form>

  </div>
</div>

  <script>
    function openPaymentModal(doctorId, doctorName) {
      document.getElementById('paymentModal').classList.remove('hidden')
      document.getElementById('doctorId').value = doctorId
      document.getElementById('doctorName').value = doctorName
    }

    function closePaymentModal() {
      document.getElementById('paymentModal').classList.add('hidden')
    }
  </script>

</body>
</html>