<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="h-screen bg-gradient-to-br from-[#FFE6DF] via-white to-[#E6F2FF] flex items-center justify-center px-4 md:px-8 py-2 overflow-hidden">

  <!-- MAIN CONTAINER -->
  <div class="w-full max-w-5xl h-full flex flex-col justify-between bg-white/70 backdrop-blur-lg rounded-[2rem] shadow-2xl p-3 md:p-6">

    <!-- HEADER -->
    <div class="flex flex-col md:flex-row items-center justify-between mb-2 md:mb-4 flex-shrink-0">
      <!-- LOGO -->
      <div class="flex-shrink-0 mb-2 md:mb-0">
        <img src="/image/dentalLogo.png" class="h-12 w-12 md:h-20 md:w-20 border border-sky-400 object-contain" alt="Clinic Logo">
      </div>

      <!-- TITLE -->
      <div class="flex-1 text-center px-2">
        <h1 
        class="text-2xl md:text-3xl lg:text-4xl font-bold text-gray-900 tracking-tight">
          <%= title %></h1>
      </div>

      <!-- DATE -->
      <div class="flex-shrink-0 text-center md:text-right mt-1 md:mt-0">
        <p class="text-gray-500 text-sm"><span class="font-medium text-sky-600"><%= selectedDate %></span></p>
      </div>
    </div>

    <!-- FORM -->
    <form id="formSubmit" action="/patient/bookAppointment" method="POST" class="flex-1 overflow-y-auto space-y-2 md:space-y-4">

      <!-- PERSONAL INFO -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-2 md:gap-4">
        <div class="flex flex-col">
          <label class="text-gray-700 font-medium text-sm md:text-base mb-1">Full Name</label>
          <input type="text" name="name" placeholder="Enter full name" required class="rounded-xl border border-gray-400 px-3 py-2 focus:ring-2 focus:ring-sky-400 w-full text-sm md:text-base"/>
        </div>
        <div class="flex flex-col">
          <label class="text-gray-700 font-medium text-sm md:text-base mb-1">Phone Number</label>
          <input type="tel" name="phone" placeholder="Enter phone number" required class="rounded-xl border border-gray-400 px-3 py-2 focus:ring-2 focus:ring-sky-400 w-full text-sm md:text-base"/>
        </div>
        <div class="flex flex-col">
          <label class="text-gray-700 font-medium text-sm md:text-base mb-1">Email Address</label>
          <input type="email" name="email" placeholder="Enter email" required class="rounded-xl border border-gray-400 px-3 py-2 focus:ring-2 focus:ring-sky-400 w-full text-sm md:text-base"/>
        </div>
      </div>

      <!-- PATIENT TYPE + TREATMENT + DATE + TIME -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-3 md:gap-6 flex-1">

  <!-- LEFT SIDE -->
  <div class="flex flex-col justify-between space-y-3 md:space-y-6 border-2 border-gray-400 rounded-2xl p-4 md:p-6 bg-white/50 backdrop-blur-sm">
    <div class="flex flex-col mt-2 md:mt-4">
      <label class="text-gray-700 font-medium text-sm md:text-base mb-1">Select Treatment</label>
      <select name="treatment" required class="px-4 py-3 border rounded-xl focus:ring-2 focus:ring-sky-400 text-sm md:text-base">
        <option value="">--Choose Treatment--</option>
        <option value="pain">Pain</option>
        <option value="cleaning">Cleaning</option>
        <option value="missingTeeth">MissingTeeth</option>
        <option value="filling">Filling</option>
        <option value="misalignedTeeth">Misaligned Teeth</option>
        <option value="routineCheckUp">Routine CheckUp</option>


      </select>
    </div>
        <p id="confirmationNotice" class="hidden text-xl md:text-2xl font-bold text-center mt-2">We will contact you soon by email or phone</p>

  </div>

  <!-- RIGHT SIDE -->
  <div class="flex flex-col justify-between space-y-3 md:space-y-6 border-2 border-gray-400 rounded-2xl p-4 md:p-6 bg-white/50 backdrop-blur-sm">
    <div class="flex flex-col">
      <label class="text-gray-700 font-medium text-sm md:text-base mb-1">Select Date</label>
      <input type="date" name="appointmentDate" id="appointmentDate" class="rounded-xl border border-gray-400 px-4 py-3 focus:ring-2 focus:ring-sky-400 text-sm md:text-base"/>
      <p class="mt-1 text-gray-600 text-sm">Selected Date: <span id="selectedDate" class="text-sky-600 font-medium">None</span></p>
    </div>

    <div class="flex flex-col">
      <label class="text-gray-700 font-medium text-sm md:text-base mb-1">Select Time Slot</label>
      <input type="hidden" name="appointmentTime" id="appointmentTime">

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
        <button type="button" data-time="10:00 AM" class="time-btn px-2 py-2 rounded-xl bg-white/60 border border-gray-400 hover:bg-sky-50 text-xs md:text-sm">10:00 AM</button>
        <button type="button" data-time="10:30 AM" class="time-btn px-2 py-2 rounded-xl bg-white/60 border border-gray-400 hover:bg-sky-50 text-xs md:text-sm">10:30 AM</button>
        <button type="button" data-time="11:00 AM" class="time-btn px-2 py-2 rounded-xl bg-white/60 border border-gray-400 hover:bg-sky-50 text-xs md:text-sm">11:00 AM</button>
        <button type="button" data-time="11:30 AM" class="time-btn px-2 py-2 rounded-xl bg-white/60 border border-gray-400 hover:bg-sky-50 text-xs md:text-sm">11:30 AM</button>
        <button type="button" data-time="02:00 PM" class="time-btn px-2 py-2 rounded-xl bg-white/60 border border-gray-400 hover:bg-rose-50 text-xs md:text-sm">2:00 PM</button>
        <button type="button" data-time="02:30 PM" class="time-btn px-2 py-2 rounded-xl bg-white/60 border border-gray-400 hover:bg-rose-50 text-xs md:text-sm">2:30 PM</button>
        <button type="button" data-time="03:30 PM" class="time-btn px-2 py-2 rounded-xl bg-white/60 border border-gray-400 hover:bg-rose-50 text-xs md:text-sm">3:30 PM</button>
        <button type="button" data-time="04:00 PM" class="time-btn px-2 py-2 rounded-xl bg-white/60 border border-gray-400 hover:bg-rose-50 text-xs md:text-sm">4:00 PM</button>
      </div>
      <p class="mt-1 text-gray-600 text-sm">Selected Time: <span id="selectedTime" class="text-sky-600 font-medium">None</span></p>
    </div>
  </div>

</div>

      <!-- SUBMIT -->
      <div id="submitButton" class="text-center pt-2">
        <button type="submit" class="px-10 py-2 md:px-14 md:py-3 rounded-full font-semibold text-white bg-gradient-to-r from-[#FF9C87] to-[#66B3FF] hover:scale-[1.03] transition-transform shadow-xl w-full sm:w-auto text-sm md:text-base">Confirm Appointment</button>
      </div>

    </form>


  </div>

  <script>
    // PATIENT TYPE
    function selectPatient(type, el){
      document.getElementById('patientType').value = type;
      document.querySelectorAll('.patient-btn').forEach(b => b.classList.remove('bg-gradient-to-r','from-[#FF9C87]','to-[#66B3FF]','text-white','shadow-lg'));
      el.classList.add('bg-gradient-to-r','from-[#FF9C87]','to-[#66B3FF]','text-white','shadow-lg');
    }

    // DATE SELECTION
    const dateInput = document.getElementById('appointmentDate');
    const selectedDate = document.getElementById('selectedDate');
    if(dateInput){
      dateInput.addEventListener('change', e => {
        const d = new Date(e.target.value);
        const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
        selectedDate.textContent = d.toLocaleDateString('en-US', options);
      });
    }

    // TIME SELECTION
const selectedTime = document.getElementById('selectedTime');
const appointmentTimeInput = document.getElementById('appointmentTime'); // hidden input

document.querySelectorAll('.time-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.time-btn').forEach(b => b.classList.remove('bg-[#FF9C87]','text-white','shadow-lg'));

    btn.classList.add('bg-[#FF9C87]','text-white','shadow-lg');

    selectedTime.textContent = btn.dataset.time;

    appointmentTimeInput.value = btn.dataset.time;
  });
});

    // FORM SUBMIT
    const form = document.getElementById('formSubmit');
    const submit = document.getElementById('submitButton');
    const confirmation = document.getElementById('confirmationNotice');
    if(form){
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        confirmation.classList.remove('hidden');
        submit.disabled = true;
        setTimeout(() => { form.submit(); }, 1000);
      });
    }
  </script>

</body>


</html>
