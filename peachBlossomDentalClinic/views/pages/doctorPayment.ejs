<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="min-h-screen bg-gradient-to-br from-[#0a9396] via-[#94d2bd] to-[#e9d8a6] font-sans">

  <div class="max-w-4xl mx-auto p-8">

    <!-- Header -->
    <div class="flex justify-between items-center mb-8">
      <h1 class="text-3xl font-bold text-gray-800"><%= title %></h1>

      <a href="/doctor/doctorHome"
         class="bg-[#005f73] text-white px-4 py-2 rounded-full hover:bg-[#003845] transition">
        Back
      </a>
    </div>

    <!-- Payments List -->
    <% if (!payments || payments.length === 0) { %>
      <div class="bg-white rounded-xl p-6 text-center text-gray-600 shadow">
        No payment records found
      </div>
    <% } %>

    <div class="space-y-4">
      <% payments.forEach(payment => { %>
        <div class="bg-white rounded-2xl shadow-lg p-6 flex justify-between items-center hover:scale-[1.01] transition">

          <!-- Month -->
          <div>
            <h2 class="text-xl font-semibold text-gray-800">
              <%= payment.month %> <%= payment.year %>
            </h2>
            <p class="text-sm text-gray-500">
              Credited on:
              <%= payment.paymentDate ? payment.paymentDate.toLocaleDateString('en-GB') : '—' %>
            </p>
          </div>

          <!-- Amount & Status -->
          <div class="text-right">
            <p class="text-2xl font-bold text-[#005f73]">
              ₹ <%= payment.totalSalary %>
            </p>

            <% if (payment.paymentStatus === 'Paid') { %>
              <span class="inline-block mt-2 bg-green-100 text-green-700 px-3 py-1 rounded-full text-sm font-medium">
                Credited
              </span>
            <% } else { %>
              <span class="inline-block mt-2 bg-yellow-100 text-yellow-700 px-3 py-1 rounded-full text-sm font-medium">
                Pending
              </span>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>

  </div>

</body>
</html>
