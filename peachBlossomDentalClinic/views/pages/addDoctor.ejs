<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Add New Dentist</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Tailwind CSS -->
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>

<body class="min-h-screen bg-gradient-to-br from-[#FF9C87] via-white to-[#66B3FF] flex items-center justify-center py-2">

  <!-- Form Container -->
  <div class="w-full max-w-3xl bg-white/70 backdrop-blur-xl border border-white/40 rounded-3xl shadow-2xl p-6 sm:p-10">

    <!-- Header -->
    <div class="flex items-center justify-center mb-6 gap-10">
      <!-- Logo -->
      <img src="/image/dentalLogo.png"
           class="h-14 w-14 border-2 border-[#FF9C87] rounded-full object-contain shadow-md"
           alt="Clinic Logo">

      <!-- Title -->
      <h1 class="text-3xl font-extrabold text-gray-800 flex items-center">
        <i class="fa-solid fa-user-doctor text-[#FF9C87] mr-2"></i>
        Add New Dentist
      </h1>
    </div>

    <!-- Add Doctor Form -->
    <form id="formSubmit" action="/admin/newDoctor" method="POST" class="space-y-5" novalidate>

      <div class="grid grid-cols-2 gap-8">

        <!-- Full Name -->
        <div>
          <label class="block text-gray-700 font-semibold mb-1">Full Name <span class="text-red-500">*</span></label>
          <input id="nameInput" type="text" name="name" required
                 class="w-full border border-gray-300 rounded-xl px-4 py-2 focus:outline-none focus:ring-2 focus:ring-[#FF9C87] bg-white/80" />
          <p id="nameError" class="text-red-600 text-xs mt-1"></p>
        </div>

        <!-- Phone -->
        <div>
          <label class="block text-gray-700 font-semibold mb-1">Phone Number <span class="text-red-500">*</span></label>
          <input id="phoneInput" type="text" name="phoneNumber" required
                 class="w-full border border-gray-300 rounded-xl px-4 py-2 focus:outline-none focus:ring-2 focus:ring-[#FF9C87] bg-white/80" />
          <p id="phoneError" class="text-red-600 text-xs mt-1"></p>
        </div>

        <!-- Email -->
        <div>
          <label class="block text-gray-700 font-semibold mb-1">Email</label>
          <input id="emailInput" type="email" name="email"
                 class="w-full border border-gray-300 rounded-xl px-4 py-2 focus:outline-none focus:ring-2 focus:ring-[#FF9C87] bg-white/80" />
          <p id="emailError" class="text-red-600 text-xs mt-1"></p>
        </div>

        <!-- Specialization -->
        <div>
          <label class="block text-gray-700 font-semibold mb-1">Specialization</label>
          <select id="specInput" name="specialization"
                  class="w-full border border-gray-300 rounded-xl px-4 py-2 focus:outline-none focus:ring-2 focus:ring-[#FF9C87] bg-white/80">
            <option value="" hidden>Select Specialization</option>
            <option value="Orthodontics">Orthodontics</option>
            <option value="Periodontics">Periodontics</option>
            <option value="Endodontics">Endodontics</option>
            <option value="Prosthodontics">Prosthodontics</option>
            <option value="Pediatric Dentistry">Pedodontics</option>
            <option value="Maxillo-Facial Surgery">Maxillo-Facial Surgery</option>
            <option value="Cosmetic Dentistry">Cosmetic Dentistry</option>
            <option value="Dental Surgeon">Dental Surgeon</option>
            <option value="Dental Therapist">Dental Therapist</option>
            <option value="Others">Others</option>
          </select>
          <p id="specError" class="text-red-600 text-xs mt-1"></p>
        </div>

        <!-- Experience -->
        <div>
          <label class="block text-gray-700 font-semibold mb-1">Experience (Years)</label>
          <input id="expInput" type="number" name="experience"
                 class="w-full border border-gray-300 rounded-xl px-4 py-2 focus:outline-none focus:ring-2 focus:ring-[#FF9C87] bg-white/80" />
          <p id="expError" class="text-red-600 text-xs mt-1"></p>
        </div>

        <!-- Salary -->
        <div>
          <label class="block text-gray-700 font-semibold mb-1">Salary</label>
          <select id="salaryInput" name="salary"
                  class="w-full border border-gray-300 rounded-xl px-4 py-2 focus:outline-none focus:ring-2 focus:ring-[#FF9C87] bg-white/80">
            <option value="" hidden>Select Salary (in pounds)</option>
            <option value="10000">£10000</option>
            <option value="9000">£9000</option>
            <option value="8000">£8000</option>
            <option value="7000">£7000</option>
            <option value="6000">£6000</option>
            <option value="5000">£5000</option>
            <option value="4000">£4000</option>
            <option value="2000">£2000</option>
            <option value="Others">Others</option>
          </select>
          <p id="salaryError" class="text-red-600 text-xs mt-1"></p>
        </div>

        <!-- Available Days -->
        <div class="md:col-span-2">
          <label class="text-gray-700 font-semibold mb-1">Available Days</label>

          <div class="flex gap-2 flex-wrap">
            <% ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'].forEach(day => { %>
              <label class="flex items-center gap-1">
                <input type="checkbox" name="availableDays" value="<%= day %>">
                <span><%= day %></span>
              </label>
            <% }) %>
          </div>
          <p id="daysError" class="text-red-600 text-xs mt-1"></p>
        </div>

      </div>

      <!-- Buttons -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center mt-6">
        <a href="/admin/doctorDetails"
           class="flex items-center justify-center gap-2 bg-[#66B3FF] text-gray-900 px-6 py-2 rounded-xl hover:bg-[#4FA0E0] transition font-semibold w-full sm:w-auto">
          <i class="fa-solid fa-arrow-left"></i> Cancel
        </a>

        <button type="submit"
           class="flex items-center justify-center gap-2 bg-[#FF9C87] text-white px-6 py-2 rounded-xl hover:bg-[#e68274] transition font-semibold w-full sm:w-auto">
          <i class="fa-solid fa-plus"></i> Add Dentist
        </button>
      </div>

    </form>
  </div>

  <!-- VALIDATION -->
  <script>
    const form = document.getElementById("formSubmit");

    const nameInput = document.getElementById("nameInput");
    const phoneInput = document.getElementById("phoneInput");
    const emailInput = document.getElementById("emailInput");
    const specInput = document.getElementById("specInput");
    const expInput = document.getElementById("expInput");
    const salaryInput = document.getElementById("salaryInput");

    const nameError = document.getElementById("nameError");
    const phoneError = document.getElementById("phoneError");
    const emailError = document.getElementById("emailError");
    const specError = document.getElementById("specError");
    const expError = document.getElementById("expError");
    const salaryError = document.getElementById("salaryError");
    const daysError = document.getElementById("daysError");

    const namePattern = /^[A-Za-z\s]+$/;
    const phonePattern = /^\d{10}$/;
    const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    // NAME 
    function validateName() {
      if (!nameInput.value.trim()) {
        nameError.textContent = "Name is required";
        return false;
      }
      if (!namePattern.test(nameInput.value)) {
        nameError.textContent = "Only alphabets allowed";
        return false;
      }
      nameError.textContent = "";
      return true;
    }

    // PHONE
    function validatePhone() {
      if (!phoneInput.value.trim()) {
        phoneError.textContent = "Phone is required";
        return false;
      }
      if (!phonePattern.test(phoneInput.value)) {
        phoneError.textContent = "Must be 10 digits";
        return false;
      }
      phoneError.textContent = "";
      return true;
    }

    // EMAIL 
    function validateEmail() {
      if (!emailInput.value.trim()) {
        emailError.textContent = "";
        return true; 
      }
      if (!emailPattern.test(emailInput.value)) {
        emailError.textContent = "Invalid email";
        return false;
      }
      emailError.textContent = "";
      return true;
    }

    // SPECIALIZATION 
    function validateSpec() {
      if (!specInput.value) {
        specError.textContent = "Select specialization";
        return false;
      }
      specError.textContent = "";
      return true;
    }

    // EXPERIENCE 
    function validateExp() {
      if (expInput.value && expInput.value < 0) {
        expError.textContent = "Invalid experience";
        return false;
      }
      expError.textContent = "";
      return true;
    }

    // SALARY 
    function validateSalary() {
      salaryError.textContent = "";
      return true;
    }

    // DAYS 
    function validateDays() {
      const checked = document.querySelectorAll("input[name='availableDays']:checked");
      if (checked.length === 0) {
        daysError.textContent = "Select at least one day";
        return false;
      }
      daysError.textContent = "";
      return true;
    }

    //  SUBMIT
    form.addEventListener("submit", function(e) {
      const ok =
        validateName() &&
        validatePhone() &&
        validateEmail() &&
        validateSpec() &&
        validateExp() &&
        validateSalary() &&
        validateDays();

      if (!ok) e.preventDefault();
    });

    // LIVE 
    nameInput.addEventListener("blur", validateName);
    phoneInput.addEventListener("input", validatePhone);
    emailInput.addEventListener("blur", validateEmail);
    specInput.addEventListener("change", validateSpec);
    expInput.addEventListener("input", validateExp);
    salaryInput.addEventListener("change", validateSalary);
  </script>

</body>
</html>