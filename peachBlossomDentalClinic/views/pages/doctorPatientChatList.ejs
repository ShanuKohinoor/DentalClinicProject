<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= title %></title>

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="min-h-screen bg-slate-50 font-sans text-slate-800">

<!-- HEADER -->
<header class="sticky top-0 z-40 bg-white/80 backdrop-blur-md border-b border-[#FFE6E0] px-6 py-4 flex justify-between items-center">
  <h1 class="text-xl font-bold">My Patients</h1>

  <input id="searchInput"
    placeholder="Search patient..."
    class="w-72 px-4 py-2 rounded-xl border border-[#FFE6E0] focus:ring-2 focus:ring-[#FF7F6B] outline-none"/>
</header>

<!-- MAIN -->
<main class="max-w-7xl mx-auto p-6">

  <% if (!patients || patients.length === 0) { %>
    <div class="text-center text-slate-400 mt-10">
      No patients found
    </div>
  <% } %>

  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5" id="patientGrid">

    <% patients.forEach(patient => { %>

      <div class="bg-white border border-[#FFE6E0] rounded-2xl shadow-sm p-5 hover:shadow-md transition">

        <!-- PATIENT HEADER -->
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 rounded-full bg-[#FFF4F1] flex items-center justify-center font-bold text-[#FF7F6B]">
            <%= patient.name.charAt(0).toUpperCase() %>
          </div>

          <div>
            <p class="font-bold text-slate-800"><%= patient.name %></p>
            <p class="text-xs text-slate-500"><%= patient.email %></p>
          </div>
        </div>

        <!-- INFO -->
        <div class="mt-3 text-xs text-slate-500">
          <p>Phone: <%= patient.phone || 'Not provided' %></p>

          <% if (patient.nextAppointmentTime) { %>
            <p class="text-[#66B3FF] font-semibold mt-1">
              Today: <%= patient.nextAppointmentTime %>
            </p>
          <% } %>
        </div>

    <!-- PATIENT CARD -->
    <div class="mt-4">
      <a href="/doctor/patient/<%= patient._id %>"
        class="w-full block text-center py-2 rounded-xl bg-[#FF7F6B] text-white text-sm">
        View Patient
      </a>
    </div>

</div>

    <% }) %>

  </div>
</main>


</body>
</html>