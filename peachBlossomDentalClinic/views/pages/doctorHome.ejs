<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>

  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

  <!-- Tailwind -->
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="min-h-screen font-sans bg-slate-50 text-slate-800">

  <!-- TOP NAV -->
  <header
    class="sticky top-0 z-40 flex items-center justify-between px-4 py-4 sm:px-6 bg-white/80 backdrop-blur-md border-b border-[#FFE6E0]">
    
    <!-- Left -->
    <div class="flex items-center gap-3 sm:gap-4 min-w-0">
      <a href="/"
        class="flex items-center justify-center w-10 h-10 rounded-xl bg-[#FFE6E0] text-[#FF7F6B] hover:bg-[#ffd6cf] transition-all duration-200 shrink-0">
        <i class="fa-solid fa-arrow-left"></i>
      </a>

      <div class="min-w-0">
        <h1 class="text-lg sm:text-xl font-bold tracking-tight text-slate-900 truncate">
          Doctor Dashboard
        </h1>
        <p class="hidden text-xs text-slate-500 md:block">
          Welcome back, Dr. <%= doctor.name ? doctor.name.split(' ').pop() : 'Doctor' %>
        </p>
      </div>
    </div>

    <!-- Right -->
    <div class="flex items-center gap-2 sm:gap-4">
      <!-- Quick Action Menu -->
      <div class="relative">
        <button id="menu-btn"
          class="flex items-center gap-2 px-3 py-2 sm:px-4 rounded-xl bg-white border border-[#FFE6E0] text-slate-700 hover:bg-slate-50 transition shadow-sm font-medium text-sm">
          <i class="fa-solid fa-layer-group text-[#FF9C87]"></i>
          <span class="hidden sm:inline">Navigation</span>
          <i class="fa-solid fa-chevron-down text-xs text-slate-400"></i>
        </button>

        <div id="menu"
          class="hidden absolute right-0 mt-2 w-56 overflow-hidden bg-white border border-[#FFE6E0] rounded-2xl shadow-xl z-50 origin-top-right">
          <div
            class="px-3 py-2 text-xs font-semibold text-slate-400 uppercase tracking-wider bg-slate-50 border-b border-slate-100">
            Management
          </div>

          <a href="/doctor/payments"
            class="flex items-center gap-3 px-4 py-3 text-sm text-slate-700 hover:bg-[#FFF4F1] hover:text-[#FF7F6B] transition">
            <i class="fa-solid fa-credit-card w-5 text-center"></i> Payments
          </a>
        </div>
      </div>

      <a href="/doctor/logout"
        class="flex items-center gap-2 px-3 py-2 sm:px-4 rounded-xl bg-[#FF7F6B] text-white hover:bg-[#ff6b55] transition text-sm font-medium shadow-sm shadow-[#FF7F6B]/20">
        <i class="fa-solid fa-right-from-bracket"></i>
        <span class="hidden sm:inline">Logout</span>
      </a>
    </div>
  </header>

  <!-- MAIN -->
  <main class="max-w-7xl px-4 py-8 mx-auto sm:px-6 lg:px-8">

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">

      <!-- LEFT COLUMN -->
      <div class="space-y-6 lg:col-span-1">

        <!-- DOCTOR PROFILE CARD -->
        <div class="relative overflow-hidden bg-white border border-[#FFE6E0] rounded-3xl p-6 shadow-sm">
          <div
            class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-bl from-[#FFE6E0] to-transparent opacity-60 rounded-bl-full pointer-events-none">
          </div>

          <div class="flex flex-col items-center text-center">
            <!-- Avatar Ring -->
            <div class="p-1.5 rounded-full bg-gradient-to-tr from-[#FF9C87] to-[#66B3FF] shadow-md">
              <div
                class="flex items-center justify-center w-18 h-18 text-3xl font-bold text-white rounded-full bg-slate-900">
                <%= doctor.name ? doctor.name.charAt(0).toUpperCase() : 'D' %>
              </div>
            </div>

            <h2 class="mt-4 text-2xl font-bold text-slate-800 text-center break-words">
              <%= doctor.name || 'Doctor Name' %>
            </h2>

            <p
              class="px-3 py-1 mt-1 text-xs font-semibold text-[#FF7F6B] bg-[#FFF4F1] rounded-full border border-[#FFE6E0] text-center">
              <%= doctor.specialization || 'Dental Specialist' %>
            </p>

            <p class="text-sm text-slate-900 mt-2 text-center">
              ID: DOC-<%= doctor.name ? doctor.name.substring(0,3).toUpperCase() : 'DOC' %>-2026
            </p>
          </div>

        </div>

        <!-- AVAILABILITY CARD -->
        <div
          class="bg-white border border-[#D6ECFF] rounded-3xl p-6 shadow-sm bg-gradient-to-b from-white to-[#F4F9FF]">
          <div class="flex items-center gap-3 mb-4">
            <div class="flex items-center justify-center w-10 h-10 rounded-xl bg-[#EAF4FF] text-[#66B3FF]">
              <i class="fa-solid fa-clock-rotate-left text-lg"></i>
            </div>

            <div>
              <h3 class="font-bold text-slate-800">Weekly Schedule</h3>
              <p class="text-xs text-slate-400">Available consulting days</p>
            </div>
          </div>

          <div class="space-y-2">
            <p
              class="text-sm font-medium text-slate-700 bg-white border border-[#D6ECFF] p-3.5 rounded-2xl shadow-sm leading-6">
              <%= doctor.availableDays && doctor.availableDays.length
                ? doctor.availableDays.join(', ')
                : 'No available days configured.' %>
            </p>
          </div>
        </div>

      </div>

      <!-- RIGHT COLUMN -->
      <div class="lg:col-span-2 space-y-6">

        <!-- QUICK ACTION CARDS -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">

          <a href="/doctor/appointments"
            class="group p-5 bg-white border border-[#FFE6E0] rounded-2xl hover:border-[#FF9C87] transition shadow-sm flex flex-col justify-between h-32">
            <div class="flex justify-between items-start">
              <div
                class="p-2 bg-[#FFF4F1] group-hover:bg-[#FF7F6B] group-hover:text-white text-[#FF7F6B] rounded-xl transition duration-200">
                <i class="fa-solid fa-calendar-days text-lg"></i>
              </div>
              <i
                class="fa-solid fa-arrow-up-right-from-square text-xs text-slate-300 group-hover:text-[#FF7F6B] transition"></i>
            </div>

            <div>
              <p class="font-bold text-slate-800 text-sm">Appointments</p>
              <p class="text-xs text-slate-400">Check schedules and bookings</p>
            </div>
          </a>

          <a href="/doctor/chatList"
            class="group p-5 bg-white border border-[#FFE6E0] rounded-2xl hover:border-[#FF9C87] transition shadow-sm flex flex-col justify-between h-32">
            <div class="flex justify-between items-start">
              <div
                class="p-2 bg-[#FFF4F1] group-hover:bg-[#FF7F6B] group-hover:text-white text-[#FF7F6B] rounded-xl transition duration-200">
                <i class="fa-solid fa-message text-lg"></i>
              </div>
              <i
                class="fa-solid fa-arrow-up-right-from-square text-xs text-slate-300 group-hover:text-[#FF7F6B] transition"></i>
            </div>

            <div>
              <p class="font-bold text-slate-800 text-sm">Patients</p>
              <p class="text-xs text-slate-400">View patient chats and records</p>
            </div>
          </a>

<div class="p-5 bg-white border border-[#FFE6E0] rounded-2xl shadow-sm h-32 flex flex-col justify-center">
  <p class="font-bold text-slate-800 text-sm">
    Next Appointment Time
  </p>

  <% if (nextTimeOnly) { %>
    <p class="text-2xl font-bold text-[#66B3FF] mt-2">
      <%= nextTimeOnly %>
    </p>
  <% } else { %>
    <p class="text-sm text-slate-400 mt-2">
      No appointments today
    </p>
  <% } %>
</div>

        </div>


        <!-- DOCTOR DETAILS -->
        <div class="bg-white border border-[#FFE6E0] rounded-3xl overflow-hidden shadow-sm">
          <div
            class="px-6 py-5 bg-gradient-to-r from-white to-[#FFF4F1] border-b border-[#FFE6E0] flex items-center justify-between gap-3">
            <div>
              <h3 class="font-bold text-slate-800 text-lg">Doctor Information</h3>
              <p class="text-xs text-slate-400">Profile details and account data</p>
            </div>

          </div>

          <div class="p-6 divide-y divide-slate-100">

            <!-- Email -->
            <div class="py-4 first:pt-0 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
              <div class="flex items-center gap-3">
                <div
                  class="w-8 h-8 rounded-lg bg-slate-50 flex items-center justify-center text-slate-400 shrink-0">
                  <i class="fa-solid fa-envelope text-sm"></i>
                </div>
                <span class="text-sm font-medium text-slate-900">Email Address</span>
              </div>

              <span
                class="text-sm font-semibold text-slate-700 break-all bg-slate-50 px-3 py-1.5 rounded-xl border border-slate-100">
                <%= doctor.email || 'Not provided' %>
              </span>
            </div>

            <!-- Phone -->
            <div class="py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
              <div class="flex items-center gap-3">
                <div
                  class="w-8 h-8 rounded-lg bg-slate-50 flex items-center justify-center text-slate-400 shrink-0">
                  <i class="fa-solid fa-phone text-sm"></i>
                </div>
                <span class="text-sm font-medium text-slate-900">Contact Number</span>
              </div>

              <span
                class="text-sm font-semibold text-slate-700 bg-slate-50 px-3 py-1.5 rounded-xl border border-slate-100">
                <%= doctor.phoneNumber || 'Not provided' %>
              </span>
            </div>

            <!-- Specialization -->
            <div class="py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
              <div class="flex items-center gap-3">
                <div
                  class="w-8 h-8 rounded-lg bg-slate-50 flex items-center justify-center text-slate-400 shrink-0">
                  <i class="fa-solid fa-stethoscope text-sm"></i>
                </div>
                <span class="text-sm font-medium text-slate-900">Specialization</span>
              </div>

              <span
                class="text-sm font-semibold text-slate-700 bg-slate-50 px-3 py-1.5 rounded-xl border border-slate-100">
                <%= doctor.specialization || 'Not provided' %>
              </span>
            </div>

            <!-- Experience -->
            <div class="py-4 last:pb-0 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
              <div class="flex items-center gap-3">
                <div
                  class="w-8 h-8 rounded-lg bg-slate-50 flex items-center justify-center text-slate-400 shrink-0">
                  <i class="fa-solid fa-award text-sm"></i>
                </div>
                <span class="text-sm font-medium text-slate-900">Experience</span>
              </div>

              <span
                class="text-sm font-semibold text-slate-700 bg-slate-50 px-3 py-1.5 rounded-xl border border-slate-100">
                <%= doctor.experience || '0' %> years
              </span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </main>

  <!-- SCRIPT -->
  <script>
    const menuBtn = document.getElementById('menu-btn');
    const menu = document.getElementById('menu');

    if (menuBtn && menu) {
      menuBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        menu.classList.toggle('hidden');
      });

      document.addEventListener('click', () => {
        menu.classList.add('hidden');
      });
    }
  </script>

</body>
</html>