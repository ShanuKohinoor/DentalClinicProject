<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="min-h-screen bg-gradient-to-br from-[#FFDED5] via-white to-[#66B3FF] flex items-center justify-center">

  <!--  Error Box -->
  <div class="max-w-lg w-full text-center p-10 rounded-3xl shadow-2xl bg-red-400 text-white">
    
    
    <!-- Status Code -->
    <p class="text-2xl font-semibold mb-4"> <%= status %></p>
    
    <!-- Error Message -->
    <div class="text-lg mb-10">
       <% messages.forEach(msg =>{ %>
         <p> <%= msg %> </p>
       <% }) %>
    </div>
    <!-- Back Button -->
    <a href="/" class="inline-block px-6 py-3 bg-white text-red-600 font-bold rounded-2xl hover:bg-gray-100 transition">
      Back to Home
    </a>
  </div>

</body>
</html>
