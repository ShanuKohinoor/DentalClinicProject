<!-- Header -->

<header class="sticky top-0 z-50 bg-[#EDBEB4] backdrop-blur shadow-sm">
  <div class="max-w-7xl mx-auto px-4 py-4 flex items-center justify-between">

    <div class="flex items-center gap-4">
      <img src="/image/dentalLogo.png"
           class="h-16 w-16 md:h-20 md:w-20 border border-sky-400 object-contain"
           alt="Clinic Logo">

      <% if (typeof showHeaderTitle !== 'undefined' && showHeaderTitle) { %>
        <h1 class="text-2xl md:text-4xl font-bold text-sky-700">
          <%= title %>
        </h1>
      <% } %>
    </div>

    <button id="menuBtn" class="flex flex-col justify-between w-8 h-8">
      <span class="block w-6 h-1 bg-black rounded"></span>
      <span class="block w-6 h-1 bg-black rounded"></span>
      <span class="block w-6 h-1 bg-black rounded"></span>
    </button>

  </div>
</header>